<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="rootRegion" maxWidth="-Infinity" minWidth="-Infinity" styleClass="primary-nav" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.framedinterface.controller.common.NavigationSidebarController">
   <children>
      <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="FrAIm">
         <graphic>
            <ImageView fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../frAIm.png" />
               </image>
            </ImageView>
         </graphic>
         <styleClass>
            <String fx:value="primary-nav__button" />
            <String fx:value="primary-nav__button--title" />
         </styleClass>
      </Button>
      <Region prefHeight="100.0" />
      <Button fx:id="dataAgnosticButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openDataAgnostic" text="Data-Agnostic">
         <graphic>
            <FontIcon iconLiteral="fa-sitemap" styleClass="primary-nav__icon" wrappingWidth="35.0" />
         </graphic>
         <styleClass>
            <String fx:value="primary-nav__button" />
            <String fx:value="primary-nav__button--menu" />
         </styleClass>
      </Button>
      <Button fx:id="dataAwareButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openDataAware" text="Data-Aware">
         <graphic>
            <FontIcon iconLiteral="fa-database" styleClass="primary-nav__icon" wrappingWidth="35.0" />
         </graphic>
         <styleClass>
            <String fx:value="primary-nav__button" />
            <String fx:value="primary-nav__button--menu" />
         </styleClass>
      </Button>
      <Region VBox.vgrow="ALWAYS" />
      <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#toggleMinimize" text="Minimize">
         <graphic>
            <FontIcon fx:id="minimizeIcon" iconLiteral="fa-angle-double-left" styleClass="primary-nav__icon" textAlignment="CENTER" wrappingWidth="30.0" />
         </graphic>
         <styleClass>
            <String fx:value="primary-nav__button" />
            <String fx:value="primary-nav__button--menu" />
         </styleClass>
      </Button>
   </children>
</VBox>
